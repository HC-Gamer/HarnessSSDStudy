# ── AI 知识库 V4 环境变量模板 ──────────────────────────────────
# 用法：cp .env.example .env 后填入真实值。.env 已在 .gitignore 里，
# 绝不提交（AGENTS.md 红线：密钥不硬编码、不入库）。

# --- LLM 提供商（OpenAI 兼容接口）---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：走别的提供商时填对应的 key
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1

# --- CostGuard 预算守卫（tests/cost_guard.py）---
# 单次运行的预算上限（元）。验证熔断：BUDGET_YUAN=0.001 python3 -m workflows.graph
BUDGET_YUAN=1.0
# 用量达到该比例时黄灯预警
BUDGET_ALERT=0.8

# --- Planner 三档策略（patterns/planner.py）---
# 数字或档位名均可：5 / 10 / 30，或 lite / standard / full
PLANNER_TARGET_COUNT=10

# --- Reviewer 五维加权评分（workflows/reviewer.py）---
# 加权总分低于该阈值就打回重写，连续两轮不过则转人工（human_flag）
REVIEWER_PASS_THRESHOLD=0.7

# --- V4 分发渠道 1：Telegram（distribution/publisher.py）---
# 两个都留空时 publisher 走 dry-run：只打印预览、返回 success=False，不崩溃
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- V4 分发渠道 2：钉钉机器人（openclaw/dingtalk_bridge.py）---
# 国内网络下 Telegram 不通时的替代通道，凭证在钉钉开放平台「企业内部应用」里拿
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# --- 段间 schema 校验闸门（validate.py，加分项）---
# 设 0 可关闭闸门做对照实验
VALIDATE_SEGMENTS=1

# --- 可选：GitHub Search API 提高限流额度 ---
# GITHUB_TOKEN=ghp_xxxxxxxx

# --- 可选：Security 限流（tests/security.py）---
# RATE_LIMIT_MAX_CALLS=120
# RATE_LIMIT_WINDOW=60
