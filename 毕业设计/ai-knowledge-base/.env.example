# ============================================================
# AI 知识库 .env.example
# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，绝不提交。
# 不配置的项留空即可，程序有默认值兜底。
# ============================================================

# --- 模型提供方（默认 deepseek） ---
# 可选: deepseek | dashscope | openai
LLM_PROVIDER=deepseek

# 按提供方填对应 Key（未用到的留空）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# 可选覆盖（一般不用填）
# LLM_MODEL=
# LLM_BASE_URL=

# --- GitHub（发布器推送到 gist/repo 时用） ---
GITHUB_TOKEN=

# --- Telegram 渠道（v4-13b 预留，未启用时留空） ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 钉钉渠道 ---
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# --- 采集量级（默认 15） ---
# 5 = lite 精简模式（成本优先）  15 = standard 标准模式（平衡）  30 = full 深度模式（质量优先）
TARGET_COUNT=15

# --- 成本守卫 ---
BUDGET_YUAN=1.0          # 单次运行预算上限（元）
BUDGET_ALERT=0.8         # 达到预算 80% 告警

# --- 审核阈值 ---
REVIEWER_PASS_THRESHOLD=7.0

# --- 校验段开关（1 开 / 0 关） ---
VALIDATE_SEGMENTS=1

# --- 速率限制（默认即可） ---
# RATE_LIMIT_MAX_CALLS=120
# RATE_LIMIT_WINDOW=60
